{
  "compilerOptions": {
    "allowJs": true,           // Allow JavaScript files
    "checkJs": false,          // Disable type checking on .js files
    "noEmit": true,            // Don't generate compiled .js files
    "module": "NodeNext",      // Support ES modules
    "moduleResolution": "NodeNext", // Ensures proper resolution of ES modules
    "strict": false,           // Relax strict mode for easier migration
    "target": "ESNext",       // Compile to modern JS
    "esModuleInterop": true,    // Enables interoperability between CommonJS and ES modules
    "resolveJsonModule": true,  // Allows importing JSON files
    "skipLibCheck": true        // Speeds up compilation by skipping type checking of declaration files
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
