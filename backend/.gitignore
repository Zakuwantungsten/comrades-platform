# Ignore package manager lock files
package-lock.json
*/package-lock.json
**/package-lock.json
pnpm-lock.yaml
yarn.lock

# Ignore node modules
node_modules/
*/node_modules/*
**/node_modules/*

# Ignore build/dist directories
dist/
build/

# Ignore logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore environment files
.env
.env.local
.env.*.local

# Ignore editor/IDE files
.vscode/
.idea/
.DS_Store

# Ignore Git-related files
.gitignore
.gitattributes
.gitmodules

# Ignore ESLint & Prettier config files
.eslint*
.prettier*
